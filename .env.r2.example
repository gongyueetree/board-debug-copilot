# Cloudflare R2 验证用环境变量模板。
#
#   cp .env.r2.example .env.r2
#   # 填好下面的值（.env.r2 已在 .gitignore 里，不会被提交）
#   set -a && . ./.env.r2 && set +a && pnpm test:storage-real
#
# 别把真实密钥写进 .env.r2.example，也别写进任何会被提交的文件。
# 完整步骤与 CORS 配置见 docs/09-storage-validation.md §3。

STORAGE_ADAPTER=s3

# R2 控制台 → R2 → 「使用 API」→ S3 API 端点
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# R2 必须是 auto，填真实区域名会签名失败
S3_REGION=auto

S3_BUCKET=<bucket-name>

# R2 控制台 → 管理 R2 API 令牌 → 创建，权限选「对象读和写」，作用域限到这一个桶
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# R2 与 MinIO 都要 path-style；AWS S3 要 false
S3_FORCE_PATH_STYLE=true
