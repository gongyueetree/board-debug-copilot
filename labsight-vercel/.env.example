OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

GEMINI_API_KEY=AIza...
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Agora EVT0.8 Realtime Voice Adapter
# Required: create these in Agora Console / Customer Console.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Optional tuning. Defaults below are used when omitted.
AGORA_CHANNEL_PREFIX=labsight-evt08
AGORA_AGENT_UID=0
AGORA_IDLE_TIMEOUT=180
AGORA_ASR_VENDOR=deepgram
AGORA_ASR_MODEL=nova-3
AGORA_ASR_LANGUAGE=multi
AGORA_LLM_VENDOR=openai
AGORA_LLM_MODEL=gpt-4o-mini
AGORA_TTS_VENDOR=minimax
AGORA_TTS_MODEL=speech-2.6-turbo
AGORA_TTS_VOICE_ID=Chinese (Mandarin)_Gentleman

# Optional: point Agora at a LabSight/OpenAI-compatible streaming LLM gateway.
# When set, this replaces the managed LLM above.
AGORA_CUSTOM_LLM_URL=
AGORA_CUSTOM_LLM_API_KEY=labsight-agora
AGORA_CUSTOM_LLM_MODEL=labsight
