OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

GEMINI_API_KEY=AIza...
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Shengwang realtime voice adapter
SHENGWANG_APP_ID=
SHENGWANG_APP_CERTIFICATE=
SHENGWANG_CUSTOMER_ID=
SHENGWANG_CUSTOMER_SECRET=

SHENGWANG_CHANNEL_PREFIX=labsight-voice
SHENGWANG_AGENT_UID=0
SHENGWANG_IDLE_TIMEOUT=180
SHENGWANG_SEMANTIC_SILENCE_MS=240
SHENGWANG_SEMANTIC_MAX_WAIT_MS=3000
SHENGWANG_INTERRUPT_MS=180
SHENGWANG_SPEAKING_INTERRUPT_MS=220
SHENGWANG_PREFIX_PADDING_MS=600
SHENGWANG_ASR_VENDOR=fengming
SHENGWANG_ASR_LANGUAGE=zh-CN

# Default: keep Gemini through Shengwang v2.10 GenericTTS.
# LabSight now has a dependency-free /api/tts_probe endpoint that uses the same
# GenericTTS protocol settings; the UI runs Probe first and Gemini second so we
# can distinguish Shengwang/Vercel reachability from Gemini protocol issues.
SHENGWANG_TTS_MODE=generic_http
SHENGWANG_TTS_URL=
SHENGWANG_CUSTOM_TTS_API_KEY=
SHENGWANG_TTS_INSTRUCTION=使用自然、清晰、专业但简洁的普通话播报，技术型号和单位准确朗读。

# Optional only: native MiniMax can still be selected explicitly if credentials
# are available, but it is no longer the default path.
# SHENGWANG_TTS_MODE=minimax
SHENGWANG_TTS_API_KEY=
SHENGWANG_TTS_GROUP_ID=
SHENGWANG_TTS_MODEL=speech-01-turbo
SHENGWANG_TTS_VOICE_ID=female-shaonv
SHENGWANG_TTS_SPEED=1.0
SHENGWANG_TTS_VOLUME=1.0
SHENGWANG_TTS_PITCH=0
SHENGWANG_TTS_SAMPLE_RATE=16000
SHENGWANG_TTS_LANGUAGE_BOOST=auto

# LabSight custom streaming LLM gateway.
SHENGWANG_CUSTOM_LLM_URL=
SHENGWANG_CUSTOM_LLM_API_KEY=
SHENGWANG_CUSTOM_LLM_MODEL=
SHENGWANG_LLM_TEMPERATURE=0.30
SHENGWANG_LLM_MAX_TOKENS=220

# Optional direct/BYOK LLM fallback if custom gateway is not used.
SHENGWANG_LLM_VENDOR=deepseek
SHENGWANG_LLM_URL=
SHENGWANG_LLM_API_KEY=
SHENGWANG_LLM_MODEL=deepseek-chat

# Compatibility: backend also reads legacy AGORA_* credential names during migration.
