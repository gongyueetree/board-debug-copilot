OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

GEMINI_API_KEY=AIza...
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Shengwang EVT0.10 Realtime Voice Adapter
# Required. Configure later in Vercel Environment Variables.
SHENGWANG_APP_ID=
SHENGWANG_APP_CERTIFICATE=
SHENGWANG_CUSTOMER_ID=
SHENGWANG_CUSTOMER_SECRET=

# Optional realtime dialogue tuning.
SHENGWANG_CHANNEL_PREFIX=labsight-voice
SHENGWANG_AGENT_UID=0
SHENGWANG_IDLE_TIMEOUT=180
SHENGWANG_SEMANTIC_SILENCE_MS=240
SHENGWANG_SEMANTIC_MAX_WAIT_MS=3000
SHENGWANG_INTERRUPT_MS=180
SHENGWANG_SPEAKING_INTERRUPT_MS=220
SHENGWANG_PREFIX_PADDING_MS=600

# TTS. Defaults target MiniMax via Shengwang ConvoAI; replace with the values
# generated by Shengwang Playground / your negotiated production voice config.
SHENGWANG_TTS_VENDOR=minimax
SHENGWANG_TTS_MODEL=speech-2.6-turbo
SHENGWANG_TTS_VOICE_ID=
SHENGWANG_TTS_URL=

# LabSight custom streaming LLM gateway.
# Leave URL blank to auto-use this Vercel deployment's /api/agora_chat endpoint.
SHENGWANG_CUSTOM_LLM_URL=
SHENGWANG_CUSTOM_LLM_API_KEY=
# Leave blank to preserve the provider selected in the LabSight UI.
SHENGWANG_CUSTOM_LLM_MODEL=
SHENGWANG_LLM_TEMPERATURE=0.30
SHENGWANG_LLM_MAX_TOKENS=220

# Optional direct/BYOK LLM fallback if custom gateway is not used.
SHENGWANG_LLM_VENDOR=deepseek
SHENGWANG_LLM_URL=
SHENGWANG_LLM_API_KEY=
SHENGWANG_LLM_MODEL=deepseek-chat

# Compatibility: the backend will also read legacy AGORA_* credential names
# during migration, but new deployments should use SHENGWANG_* above.
