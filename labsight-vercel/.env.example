OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

GEMINI_API_KEY=AIza...
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Public production URL used for Shengwang callbacks and /api/session origin checks.
LABSIGHT_PUBLIC_BASE_URL=https://labsight.tindie.com

# Browser API session guard. Generate with: openssl rand -hex 32
# If left empty, the guard is disabled for local/development compatibility.
LABSIGHT_SESSION_SECRET=
# Optional additional browser origin allowed to mint a session token.
LABSIGHT_EXTRA_ALLOWED_ORIGIN=

# Shengwang realtime voice adapter
SHENGWANG_APP_ID=
SHENGWANG_APP_CERTIFICATE=
SHENGWANG_CUSTOMER_ID=
SHENGWANG_CUSTOMER_SECRET=

SHENGWANG_CHANNEL_PREFIX=labsight-voice
SHENGWANG_AGENT_UID=0
SHENGWANG_IDLE_TIMEOUT=180

# Shengwang engineering tuning (2026-09): reduce false barge-in.
# start_of_speech uses semantic mode with the supplied vad_config thresholds.
SHENGWANG_SOS_MODE=semantic
SHENGWANG_INTERRUPT_MS=480
SHENGWANG_SPEAKING_INTERRUPT_MS=600
SHENGWANG_PREFIX_PADDING_MS=800
SHENGWANG_SPEECH_THRESHOLD=0.20

# End-of-speech can remain VAD for lower latency, or switch to semantic when needed.
SHENGWANG_EOS_MODE=vad
SHENGWANG_VAD_SILENCE_MS=600
SHENGWANG_SEMANTIC_SILENCE_MS=240
SHENGWANG_SEMANTIC_MAX_WAIT_MS=3000
SHENGWANG_ASR_VENDOR=fengming
SHENGWANG_ASR_LANGUAGE=zh-CN

# TTS modes:
# - generic_http: current Gemini TTS bridge (works without MiniMax, but is non-streaming and slower)
# - minimax: Shengwang native MiniMax TTS path; recommended for latency/continuity tests
# - auto: use MiniMax when a MiniMax key exists, otherwise fall back to Gemini GenericTTS
SHENGWANG_TTS_MODE=generic_http
SHENGWANG_TTS_URL=
# Dedicated random callback secret. Do not reuse APP_CERTIFICATE.
SHENGWANG_CUSTOM_TTS_API_KEY=
SHENGWANG_TTS_INSTRUCTION=使用自然、清晰、专业但简洁的普通话播报，技术型号和单位准确朗读。

# Native MiniMax TTS through Shengwang. A MiniMax API credential is still required
# by the current Shengwang CN API; there is no assumption of a managed credential.
SHENGWANG_TTS_API_KEY=
SHENGWANG_TTS_GROUP_ID=
SHENGWANG_TTS_MODEL=speech-2.6-turbo
SHENGWANG_TTS_VOICE_ID=female-shaonv
SHENGWANG_TTS_SPEED=1.0
SHENGWANG_TTS_VOLUME=1.0
SHENGWANG_TTS_PITCH=0
SHENGWANG_TTS_SAMPLE_RATE=16000
SHENGWANG_TTS_LANGUAGE_BOOST=auto

# LabSight custom streaming LLM gateway.
SHENGWANG_CUSTOM_LLM_URL=
# REQUIRED for public Shengwang custom LLM callback. Generate independently with:
# openssl rand -hex 32 . Never reuse SHENGWANG_APP_CERTIFICATE.
SHENGWANG_CUSTOM_LLM_API_KEY=
SHENGWANG_CUSTOM_LLM_MODEL=
SHENGWANG_LLM_TEMPERATURE=0.30
# Raised from 220 so voice subtitles do not end mid-sentence; the system prompt
# still keeps normal voice replies to 1-4 short complete sentences.
SHENGWANG_LLM_MAX_TOKENS=384
# Temporarily set to 1 to log the complete LLM text to Vercel logs while debugging
# subtitle truncation. Keep 0 in normal production because the log contains user text.
SHENGWANG_LLM_TRACE=0

# Optional direct/BYOK LLM fallback if custom gateway is not used.
SHENGWANG_LLM_VENDOR=deepseek
SHENGWANG_LLM_URL=
SHENGWANG_LLM_API_KEY=
SHENGWANG_LLM_MODEL=deepseek-chat

# Compatibility: backend also reads legacy AGORA_* credential names during migration.
