NODE_ENV=development
MOCK_MODE=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bdc?schema=public
REDIS_URL=redis://localhost:6379

# mock = 本地盘（无盘时退回内存）；s3 = 任何 S3 兼容端点
# 配置不全时自动降级为 mock，/health 的 storage.degraded 会标出来
#
# NODE_ENV=production 时不允许 mock：对象会随容器重建消失，api 与 worker
# 也看不到对方的文件。api 与 worker 都会拒绝启动（见 docs/09）
STORAGE_ADAPTER=mock
STORAGE_ROOT=

# 生产用 mock 的显式豁免，只给内置 Demo。豁免后能启动，
# 但 /health 的 storage.degraded 仍然是 true
ALLOW_MOCK_STORAGE_IN_PRODUCTION=false

# Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com  region=auto  path-style=true
# AWS S3:         留空 endpoint，填真实 region，path-style=false
# MinIO:          http://localhost:9000  region=auto  path-style=true
#                 本地起：docker compose -f docker-compose.storage.yml up -d
#                 验证：  pnpm test:storage-real
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# mock | gemini | claude | deepseek
# 缺对应 key 时自动降级为 mock，不会报错
LLM_PROVIDER=mock
LLM_CHAT_MODEL=
LLM_VISION_MODEL=

# 按 LLM_PROVIDER 配其中一个即可；也可统一用 LLM_API_KEY
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 简单登录的签名密钥。不配会随机生成，重启后登录态失效
AUTH_SECRET=

# worker 回调 api 的地址（同一 Railway 项目内用内网域名）
API_INTERNAL_URL=http://localhost:3001
WORKER_CONCURRENCY=2

API_PORT=3001
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_BRIDGE_URL=http://127.0.0.1:3777

BRIDGE_ALLOWED_ORIGINS=http://localhost:3000
BRIDGE_PAIRING_SECRET=
BRIDGE_MOCK=true
BRIDGE_SCENARIO=gain_error
# 配对开关。CI 与内置 Demo 可关，生产不要关
BRIDGE_REQUIRE_PAIRING=true
# 免配对切换 mock 场景。仅供 CI 与内置 Demo，生产不要开。
# BRIDGE_MOCK=true 本身不构成豁免 —— 场景切换会改变波形与 AI 诊断
BRIDGE_ALLOW_UNPAIRED_DEBUG=false
# 配对 token 存放位置，默认 ~/.board-debug-copilot/bridge.json
BRIDGE_CONFIG=


# ── 器件库（P9，ezPLM）─────────────────────────────────────────
# mock = 内置常识参数（只有 Demo 那几颗）；remote = ezPLM 系统库
# MOCK_MODE=true 时即使写 remote 也强制走 mock，且不发起任何真实请求
#
# 注意 ezPLM 的配额是**按天**计的（超了 429），不是按 QPS。
# 所以不要为了跑快而并发 —— 只会更快烧完当天额度。
PARTS_PROVIDER=mock
PARTS_API_KEY=                    # 唯一必填项。仅服务端，禁止出现在 apps/web
PARTS_API_BASE_URL=               # 留空即 https://www.ezplm.cn

# 也认 EZPLM_* 这套名字（PARTS_* 优先）：手册与联调步骤里用的是它们。
#   EZPLM_API_KEY / EZPLM_BASE_URL / EZPLM_PAGE_SIZE / EZPLM_TIMEOUT_MS
# 注意仍要 PARTS_PROVIDER=remote 才会真的走远端；只设 key 不改 provider 时
# /health 的 parts.lastError 会提醒你。
PARTS_PAGE_SIZE=50
PARTS_TIMEOUT_MS=15000
PARTS_CACHE_TTL_DAYS=7
PARTS_EMBED_ON_MIRROR=true

# 联调（会消耗当天配额）：
#   PARTS_PROVIDER=remote PARTS_API_KEY=<key> pnpm test:parts-real

# kicad-cli 可执行文件路径。留空则从 PATH 找。
# macOS 上它不在 PATH 里：
#   /Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
# 验证真实工程解析：pnpm test:kicad-real（没装就 SKIPPED）
KICAD_CLI=
