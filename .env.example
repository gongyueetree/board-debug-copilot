NODE_ENV=development
MOCK_MODE=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bdc?schema=public
REDIS_URL=redis://localhost:6379

STORAGE_ADAPTER=mock
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# mock | gemini | claude | deepseek
# 缺对应 key 时自动降级为 mock，不会报错
LLM_PROVIDER=mock
LLM_CHAT_MODEL=
LLM_VISION_MODEL=

# 按 LLM_PROVIDER 配其中一个即可；也可统一用 LLM_API_KEY
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 简单登录的签名密钥。不配会随机生成，重启后登录态失效
AUTH_SECRET=

API_PORT=3001
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_BRIDGE_URL=http://127.0.0.1:3777

BRIDGE_ALLOWED_ORIGINS=http://localhost:3000
BRIDGE_PAIRING_SECRET=
BRIDGE_MOCK=true
BRIDGE_SCENARIO=gain_error

STORAGE_ROOT=
