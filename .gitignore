node_modules/
.pnpm-store/
dist/
build/

# 构建产物绝不能落在 src/ —— P0 时期 tsc 曾往 src 里写过 .js/.d.ts 并被提交
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map
.next/
out/
.turbo/
*.tsbuildinfo

.env
.env.*
!.env.example

.vercel/
.railway/

__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

# 只忽略 mock 对象存储的落盘目录；不要写成 storage/，
# 那会连 apps/api/src/storage/ 这样的源码目录一起忽略掉
/storage/
/apps/*/storage/
/tmp/
coverage/
