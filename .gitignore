node_modules/
.pnpm-store/
dist/
build/

# 构建产物绝不能落在 src/ —— P0 时期 tsc 曾往 src 里写过 .js/.d.ts 并被提交
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.map
.next/
out/
.turbo/
*.tsbuildinfo

.env
.env.*
# 只放占位值的模板要留在仓库里；真实凭据一律走 .env / .env.r2 这类被忽略的文件
!.env.example
!.env.r2.example

# kicad-cli / KiCad GUI 跑一次就会在工程目录里留下这些本地状态。
# 它们不是工程的一部分，提交进去只会在每次跑 test:kicad-real 后产生噪声 diff。
*.kicad_prl
~*.lck
**/-backups/
**/fp-info-cache

.vercel/
.railway/

__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

# 只忽略 mock 对象存储的落盘目录；不要写成 storage/，
# 那会连 apps/api/src/storage/ 这样的源码目录一起忽略掉
/storage/
/apps/*/storage/
/tmp/
coverage/
